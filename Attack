function NearestEnemiesCanAttack()
    local t = {}

    if not Character then
        return t
    end

    local MyRoot = Character:FindFirstChild("HumanoidRootPart")
    if not MyRoot then
        return t
    end

    for _, Enemy in ipairs(workspace.Enemies:GetChildren()) do
        if Enemy:FindFirstChild("Humanoid").Health > 0 and not Enemy:GetAttribute("IsBoat") then
            local EnemyRoot = Enemy:FindFirstChild("HumanoidRootPart")

            if EnemyRoot then
                local Dis = (EnemyRoot.Position - MyRoot.Position).Magnitude

                if Dis <= 350 then
                    table.insert(t, {
                        Model = Enemy,
                        Distance = Dis
                    })
                end
            end
        end
    end

    table.sort(t, function(a, b)
        return a.Distance < b.Distance
    end)

    return t
end

